# ==============================================================================
# Clazzy Environment Variables Template
# Copy this file to .env and configure for your environment.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# MongoDB Configuration (Optional for cloud storage / user profile persistence)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/clazzy?retryWrites=true&w=majority

# Express Server Configuration (Optional local dev server)
PORT=5000
NODE_ENV=development

# Python FastAPI ML Backend URL (Default local: http://localhost:8000 or http://localhost:8001)
# When deployed, point to your deployed Python backend (e.g. Render / Railway)
VITE_API_URL=http://localhost:8000

# Storage Provider: "true" for browser IndexedDB (default, no cloud needed), "false" for Firebase
VITE_USE_LOCAL_STORAGE=true

# Firebase Configuration (Optional, only needed if VITE_USE_LOCAL_STORAGE=false)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
